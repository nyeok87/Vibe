# 복사해서 .env.local 로 저장 (Vercel에는 Project Settings > Environment Variables 에 입력)

# 초기 공용 접속코드 / 관리자 비밀번호 (첫 실행 때 해시로 저장, 이후 설정 화면에서 변경)
ACCESS_CODE=1234
ADMIN_PASSWORD=admin1234

# 세션 쿠키 서명 키 (임의의 긴 문자열)
SESSION_SECRET=change-this-to-a-long-random-string

# Supabase (비워 두면 로컬 .data 폴더에 저장 — 개발·시연용. Vercel 배포 시 필수)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=files
